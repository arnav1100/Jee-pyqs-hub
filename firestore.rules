rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public read-only content: subjects, chapters, questions.
    // Only admins (custom claim `admin: true`) can write — set that claim
    // from a trusted backend / Cloud Function, never from the client.
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAdmin();

        match /questions/{questionId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // Site-wide settings (name, logo, pricing, announcement banner, UPI/QR
    // payment details). Publicly readable so the storefront can render
    // pricing/announcement without an admin session; only admins can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile docs, created by the signed-in user themselves at
    // sign-up (see lib/auth-context.tsx: upsertUserProfile, which also
    // activates the 12h free trial) and updated by admins (plan
    // upgrades/downgrades, payment approvals). A regular user may create
    // their own doc once and update their own non-sensitive profile
    // fields, but may NOT set or change `plan`, `planExpiresAt`,
    // `trialStart` or `trialEnd` themselves after creation — only an
    // admin (via the payment-approval flow) can grant a plan, and the
    // trial window is fixed for the lifetime of the account.
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.plan == 'free'
        && (!('planExpiresAt' in request.resource.data) || request.resource.data.planExpiresAt == null)
        && (!('trialStart' in request.resource.data) || request.resource.data.trialStart is string)
        && (!('trialEnd' in request.resource.data) || request.resource.data.trialEnd is string);

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.planExpiresAt == resource.data.planExpiresAt
          && request.resource.data.trialStart == resource.data.trialStart
          && request.resource.data.trialEnd == resource.data.trialEnd
        );

      allow delete: if isAdmin();

      // Per-user, per-chapter practice progress (answers, bookmark flags,
      // attempted/correct/wrong counters, completed flag) — only the
      // owner can read/write their own, admins can read for analytics.
      match /progress/{chapterId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Per-user bookmarked questions (mirrors progress.bookmarked but
      // queryable on its own, e.g. a "My Bookmarks" page).
      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // Per-user timed-test attempt history.
      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }

      // Subscription activation history (one doc per approved payment).
      // Written only by the admin approval flow; the owner can read their
      // own history.
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Payment requests (manual UPI/QR verification). A signed-in user may
    // submit their own pending request (the "I Have Paid" form); only an
    // admin can read the queue, approve/reject, or edit a request after
    // submission — this keeps other users from seeing or tampering with
    // payment proof/transaction IDs that aren't theirs.
    match /payments/{paymentId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
